  "_roleNote": "Role is answered by BEHAVIOUR first and vocabulary second \u2014 the opposite of type. An explicit _SP/_PV suffix outranks both because it is a deliberate statement of intent.",
  "roleSuffix": {
    "SP": "SETPOINT",
    "SETPOINT": "SETPOINT",
    "CMD": "SETPOINT",
    "TARGET": "SETPOINT",
    "REF": "SETPOINT",
    "PV": "PROCESS_VAR",
    "FB": "PROCESS_VAR",
    "FBK": "PROCESS_VAR",
    "ACT": "PROCESS_VAR",
    "ACTUAL": "PROCESS_VAR"
  },
  "behaviour": {
    "booleanIsState": true,
    "monotonicIsCounter": true,
    "setpointMaxChangeRatio": 0.05,
    "setpointMaxDistinct": 6,
    "stateMaxDistinct": 8,
    "minSamplesForBehaviour": 20,
    "udtMinInstances": 2,
    "udtMinAgreement": 0.75
  },
  "_confidenceNote": "Auto-apply is deliberately generous (0.80) because classification is reversible and low blast-radius \u2014 unlike equipment assignment, which needs a human. Everything below `review` is left null rather than guessed.",
  "confidence": {
    "tokenAndUomAgree": 0.97,
    "uomMultiNarrowedByToken": 0.93,
    "uomUnique": 0.9,
    "strongToken": 0.88,
    "behaviourOnly": 0.72,
    "weakToken": 0.62,
    "conflict": 0.55
  },
  "thresholds": {
    "autoApply": 0.8,
    "review": 0.55
  },
  "_configEvidenceNote": "Ignition's engLow/engHigh and valueSource are CONFIG properties, not history \u2014 readable in the same cheap query as the name. They stand in for the two behaviours that would otherwise force value sampling: a huge integer engineering range implies a tally, and valueSource=memory implies nothing upstream writes a reading (i.e. a setpoint).",
  "configEvidence": {
    "counterMinEngHigh": 10000,
    "rangeVetoFactor": 20,
