FROM node:22-alpine
# No npm dependencies by design — the kernels are dependency-free and node 22 has fetch built in.
#
# Build context is the REPO ROOT. platform/fuuz-api.js is a shim re-exporting vendor/fuuz-api,
# so the relative require inside orchestrator/ and docdrop/ resolves unchanged.
WORKDIR /app
COPY package.json ./
COPY vendor/fuuz-api ./vendor/fuuz-api
COPY platform/fuuz-api.js ./platform/fuuz-api.js
COPY core/kernel ./core/kernel
COPY docdrop ./docdrop
COPY latency ./latency
COPY orchestrator ./orchestrator
ENV NODE_ENV=production
EXPOSE 8099
HEALTHCHECK --interval=20s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8099)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "orchestrator/server.js"]
