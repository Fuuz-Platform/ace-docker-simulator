# cp .env.example .env and fill in. NEVER commit .env.
#
# NONE OF THIS IS NEEDED FOR THE SIMULATOR ITSELF. `docker compose up -d` runs the plant, the
# historian, the GraphQL API and the console with no configuration at all. Everything below is for
# the optional `fuuz` profile, which points ACE at a live Fuuz tenant.

# ── Fuuz tenant (required only for: docker compose --profile fuuz up -d) ─────────────────────
FUUZ_HOST=
FUUZ_TENANT=
# The per-tenant JWT. Treat it as a credential: it is not scoped to read-only.
FUUZ_TOKEN=

# ── inference ────────────────────────────────────────────────────────────────────────────────
# Defaults assume Docker Model Runner, which runs the model HOST-side on llama.cpp and therefore
# gets the GPU a Docker Desktop container never can:
#   docker model pull hf.co/ggml-org/bge-m3-Q8_0-GGUF
#   docker model pull ai/qwen3
# Reached from a container at http://model-runner.docker.internal/engines/v1 (host: :12434).
LLM_URL=http://model-runner.docker.internal/engines/v1
LLM_MODEL=docker.io/ai/qwen3
# Bearer key for the OpenAI-compatible endpoint. Blank for Docker Model Runner; required when LM
# Studio's server is started with auth enabled, which answers an unauthenticated call with a 401
# that reads like a model failure.
LLM_API_KEY=

# bge-m3, NOT multilingual-e5-small: every GGUF build of e5-small has a broken tokenizer that
# returns bit-identical vectors for distinct CamelCase inputs (cosine 1.000000 for MotorTemp vs
# BatchId). It does not error, so it silently poisons the index — and CamelCase is exactly what
# every OPC UA tag leaf is.
EMBED_URL=http://model-runner.docker.internal/engines/v1
EMBED_API=openai
EMBED_MODEL=huggingface.co/ggml-org/bge-m3-q8_0-gguf
EMBED_DIMS=1024
EMBED_API_KEY=

# ── simulator + historian tuning (all optional, sane defaults in docker-compose.yml) ─────────
SIM_TICK_MS=2000
HISTORIAN_TTL_DAYS=3
BRIDGE_FLUSH_MS=5000
BRIDGE_SAMPLING_MS=1000
LOADGEN_TAGS=2000
LOADGEN_RATE=2000
LOADGEN_BATCH_MS=250
